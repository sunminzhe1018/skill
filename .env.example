# 复制为 .env 后填入你的阿里百炼 API Key
# 获取地址: https://bailian.console.aliyun.com/ → API-KEY 管理

DASHSCOPE_API_KEY=sk-在此填入你的百炼API密钥


# 对话模型（可按控制台可用模型修改）
DASHSCOPE_MODEL=qwen-plus

# 地域端点：北京（默认）| 新加坡用 dashscope-intl
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 联网搜索（与百炼控制台一致，查天气需开启；设为 false 可关闭）
ENABLE_SEARCH=true

# 服务端口
PORT=3000
